# Copy this file to .env and adjust for your server, then run:
#   docker compose up -d --build
# .env is git-ignored; never commit real secrets in it.

# Port exposed on the host (container always listens on 8080 internally)
HTTP_PORT=8080

ASPNETCORE_ENVIRONMENT=Production

SITE_NAME=Follows
ALLOW_PUBLIC_REGISTRATION=false
DEFAULT_THEME_MODE=System

# --- Mail (optional) ---------------------------------------------------
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=StartTls
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_FROM_ADDRESS=
MAIL_SMTP_FROM_NAME=
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=SslOnConnect
MAIL_IMAP_USERNAME=
MAIL_IMAP_PASSWORD=

# --- Optional integrations ---------------------------------------------
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
SMS_BASE_URL=
SMS_API_KEY=
