# Copy this file to .env and adjust for your server, then run:
#   docker compose up -d --build
# .env is git-ignored; never commit real secrets in it.

# Port exposed on the host (container always listens on 8080 internally)
HTTP_PORT=8080

ASPNETCORE_ENVIRONMENT=Production

SITE_NAME=Follows
ALLOW_PUBLIC_REGISTRATION=false
DEFAULT_THEME_MODE=System

# --- Mail (optional) ---------------------------------------------------
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=StartTls
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_FROM_ADDRESS=
MAIL_SMTP_FROM_NAME=
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=SslOnConnect
MAIL_IMAP_USERNAME=
MAIL_IMAP_PASSWORD=

# --- AI Gateway (optional) ----------------------------------------------
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_DEFAULT_CHAT_MODEL=
AI_GATEWAY_DEFAULT_LANGUAGE=Dansk
AI_GATEWAY_DEFAULT_TTS_MODEL=
AI_GATEWAY_DEFAULT_TTS_VOICE=
AI_GATEWAY_DEFAULT_STT_MODEL=
# Non-reasoning chat model for translation (Documents "Oversæt"-button, Feed auto-translate, toast-
# oversættelse og UI-katalog-oversættelse ved sprog-installation under Indstillinger → Sprog);
# blank = use AI_GATEWAY_DEFAULT_CHAT_MODEL. See AiGatewaySettings.TranslationModel.
AI_GATEWAY_TRANSLATION_MODEL=qwen2.5:14b-instruct
AI_GATEWAY_REQUEST_TIMEOUT_SECONDS=600

# --- Ollama (optional) ---------------------------------------------------
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_DEFAULT_CHAT_MODEL=
OLLAMA_DEFAULT_GENERATE_MODEL=
OLLAMA_DEFAULT_EMBEDDING_MODEL=
OLLAMA_DEFAULT_KEEP_ALIVE=
OLLAMA_DEFAULT_LANGUAGE=Dansk
OLLAMA_USE_STREAMING_BY_DEFAULT=false
OLLAMA_REQUEST_TIMEOUT_SECONDS=600

# --- SMS (optional) -------------------------------------------------------
SMS_BASE_URL=
SMS_API_KEY=
SMS_WORKER_INTERVAL_SECONDS=30
