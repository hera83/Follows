@using web.Constants
@using web.Data
@using web.Data.Entities
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@{
    Layout = null;
    var themeMode = await Db.AppSettings
        .AsNoTracking()
        .Where(s => s.Key == AppSettingKeys.ActiveThemeMode)
        .Select(s => s.Value)
        .FirstOrDefaultAsync() ?? ThemeMode.System;

    string returnUrl = ViewBag.ReturnUrl;
    string languageCode = ViewBag.LanguageCode;
    string waitMessage = ViewBag.WaitMessage;
}

<!DOCTYPE html>
<html lang="da" data-theme-mode="@themeMode">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Follows</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="alternate icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <script>
        (function () {
            var mode = (document.documentElement.dataset.themeMode || 'system').toLowerCase();
            var theme;
            if (mode === 'light') { theme = 'light'; }
            else if (mode === 'dark') { theme = 'dark'; }
            else { theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'; }
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" id="themeStylesheet" href="~/theme.css" asp-append-version="true" />
</head>
<body>
    <div class="auth-wrapper">
        <div class="auth-card text-center">
            <div class="auth-logo">
                <i class="bi bi-chat-heart-fill"></i>
                <h1>Follows</h1>
            </div>

            <div class="spinner-border text-primary my-3" role="status">
                <span class="visually-hidden">@waitMessage</span>
            </div>
            <p id="uiLocalizationWaitMessage">@waitMessage</p>
            <div class="progress" style="height: 6px;" role="progressbar" aria-label="@waitMessage">
                <div id="uiLocalizationProgressBar" class="progress-bar" style="width: 0%"></div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var languageCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(languageCode));
            var returnUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(returnUrl));
            var statusUrl = '@Url.Action("Status", "UiLocalization")';
            var progressBar = document.getElementById('uiLocalizationProgressBar');

            function goToDestination() {
                window.location.href = returnUrl;
            }

            function poll() {
                fetch(statusUrl + '?languageCode=' + encodeURIComponent(languageCode), { credentials: 'same-origin' })
                    .then(function (response) {
                        if (!response.ok) { goToDestination(); return null; }
                        return response.json();
                    })
                    .then(function (data) {
                        if (!data) return;

                        if (data.total > 0) {
                            var percent = Math.min(100, Math.round((data.completed / data.total) * 100));
                            progressBar.style.width = percent + '%';
                        }

                        if (data.status === 'completed') {
                            goToDestination();
                            return;
                        }

                        setTimeout(poll, 1500);
                    })
                    .catch(function () {
                        // Network hiccup — keep polling rather than stranding the viewer on this page.
                        setTimeout(poll, 3000);
                    });
            }

            // Safety net: never leave the viewer stuck here even if something goes wrong client-side.
            setTimeout(goToDestination, 10 * 60 * 1000);

            poll();
        })();
    </script>
</body>
</html>
