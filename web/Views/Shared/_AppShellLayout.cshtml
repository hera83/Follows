@using web.Data
@using web.Data.Entities
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager
@{
    // Standalone shell for the installable PWA ("/app/..." — see PwaShellMiddleware), scoped to
    // Feeds/Documents/Min Profil only. Deliberately does NOT extend/reuse _Layout.cshtml (which must
    // stay completely untouched) — this is its own <html> document, mirroring the theme-resolution
    // logic in _Layout.cshtml so both shells always render the same light/dark theme for the same
    // viewer, and reusing site.css/theme.css unmodified for every shared component (cards, buttons,
    // forms, feed/document components, toasts, modals). Only the chrome below (top bar + collapsible
    // menu panel) is new, styled entirely from pwa-shell.css under its own "pwa-*" class namespace so
    // nothing here can collide with — or need any change to — the desktop sidebar's CSS.
    var currentUser = await UserManager.GetUserAsync(User);
    var currentUserId = currentUser?.Id;
    var hasAvatar = currentUser?.ProfilePictureId.HasValue == true;

    var themeMode = currentUser?.ThemePreference;
    if (string.IsNullOrEmpty(themeMode))
    {
        themeMode = await Db.AppSettings
            .AsNoTracking()
            .Where(s => s.Key == AppSettingKeys.ActiveThemeMode)
            .Select(s => s.Value)
            .FirstOrDefaultAsync() ?? ThemeMode.System;
    }
}
<!DOCTYPE html>
<html lang="da" data-theme-mode="@themeMode">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Follows</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="alternate icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#c94e24" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Follows" />
    <script>
        (function () {
            var mode = (document.documentElement.dataset.themeMode || 'system').toLowerCase();
            var theme;
            if (mode === 'light') { theme = 'light'; }
            else if (mode === 'dark') { theme = 'dark'; }
            else { theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'; }
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" id="themeStylesheet" href="~/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pwa-shell.css" asp-append-version="true" />
</head>
<body>
    <div class="pwa-shell" id="pwaShell">
        <header class="pwa-topbar">
            <span class="pwa-topbar-brand">
                <i class="bi bi-chat-heart-fill"></i>
                <span>Follows</span>
            </span>
            <button id="pwaMenuToggle" class="pwa-menu-toggle" type="button"
                    aria-label="@T("Åbn menu")" aria-expanded="false" aria-controls="pwaMenuPanel">
                <i class="bi bi-list"></i>
            </button>
        </header>

        <div id="pwaMenuBackdrop" class="pwa-menu-backdrop"></div>

        <nav id="pwaMenuPanel" class="pwa-menu-panel" aria-label="@T("Hovedmenu")">
            <a class="pwa-nav-link" href="/app/Feed" title="@T("Feeds")">
                <span class="pwa-nav-icon"><i class="bi bi-images"></i></span>
                <span class="pwa-nav-text">@T("Feeds")</span>
            </a>
            <a class="pwa-nav-link" href="/app/Documents" title="@T("Documents")">
                <span class="pwa-nav-icon"><i class="bi bi-folder2-open"></i></span>
                <span class="pwa-nav-text">@T("Documents")</span>
            </a>
            <a class="pwa-nav-link" href="/app/Profile" title="@T("Min Profil")">
                <span class="pwa-nav-icon" id="pwaAvatarWrapper">
                    @if (hasAvatar && currentUserId is not null)
                    {
                        <img src="@Url.Action("Avatar", "Profile", new { userId = currentUserId })"
                             class="pwa-nav-avatar" alt="@T("Profilbillede")" />
                    }
                    else
                    {
                        <i class="bi bi-person-circle"></i>
                    }
                </span>
                <span class="pwa-nav-text">@T("Min Profil")</span>
            </a>

            <hr class="pwa-menu-divider" />

            <form asp-controller="Account" asp-action="Logout" method="post" class="pwa-menu-form">
                <button type="submit" class="pwa-nav-link pwa-nav-logout w-100" title="@T("Log ud")">
                    <span class="pwa-nav-icon"><i class="bi bi-box-arrow-right"></i></span>
                    <span class="pwa-nav-text">@T("Log ud")</span>
                </button>
            </form>
        </nav>

        <div class="pwa-content">
            @await Html.PartialAsync("~/Views/Shared/Partials/_Toast.cshtml")
            @RenderBody()
        </div>
    </div>

    <script>
        window.i18n = @JsCatalogJson();
        window.appLocale = '@web.Constants.AppLanguages.GetLocaleTag(CurrentLanguage)';
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/data-table.js" asp-append-version="true"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
    <script src="~/js/pwa-shell.js" asp-append-version="true"></script>
    <script>
        (function () {
            // Headless in the normal case — the PWA shell never shows its own install button (that
            // lives only on the desktop Min Profil page, see Profile/Index.cshtml). This:
            //   1) registers the service worker (required for installability at all),
            //   2) auto-triggers the native install prompt whenever the browser offers one, if the
            //      desktop "Installer" button sent the viewer here to do exactly that (flagged via a
            //      query param, not sessionStorage/a cookie — those don't reliably survive an
            //      http->https scheme redirect, i.e. a different origin, which query strings do),
            //   3) since "beforeinstallprompt" is unreliable in practice (browser engagement
            //      heuristics, a cooldown after an earlier dismissal, or simply not supported at all
            //      on some browsers) - immediately shows reliable manual "how to install" steps too,
            //      instead of leaving the viewer with nothing if the automatic path doesn't fire.
            var params = new URLSearchParams(location.search);
            var installRequested = params.get('installRequested') === '1';

            if (installRequested) {
                // Strip the flag from the visible/shareable URL right away.
                params.delete('installRequested');
                var rest = params.toString();
                history.replaceState(null, '', location.pathname + (rest ? '?' + rest : '') + location.hash);
            }

            var deferredPrompt = null;
            var promptFired = false;
            var autoPromptDone = false;

            var tryAutoPrompt = function () {
                if (autoPromptDone || !installRequested || !deferredPrompt) return;
                autoPromptDone = true;
                deferredPrompt.prompt();
                deferredPrompt = null;
            };

            window.addEventListener('beforeinstallprompt', function (e) {
                e.preventDefault();
                deferredPrompt = e;
                promptFired = true;
                tryAutoPrompt();
            });

            window.addEventListener('appinstalled', function () {
                document.getElementById('pwaInstallHelp')?.remove();
            });

            var swSupported = 'serviceWorker' in navigator;
            var swOk = null, swError = null;

            // Scope narrowed to "/app/" so it can never intercept requests for the desktop app.
            var swPromise = swSupported
                ? navigator.serviceWorker.register('/sw.js', { scope: '/app/' })
                    .then(function () { swOk = true; })
                    .catch(function (err) { swOk = false; swError = (err && err.message) || String(err); })
                : Promise.resolve();

            if (!installRequested) return;

            // Reliable path: show manual steps right away rather than wait and hope.
            var isEdge = /EdgA\//.test(navigator.userAgent);
            var steps = isEdge
                ? @TJs("Tryk på menuen (⋯) i Edge, og vælg \"Tilføj til telefon\" eller \"Installer app\".")
                : @TJs("Tryk på menuen (⋮) i browseren, og vælg \"Installer app\" eller \"Føj til startskærm\".");

            var help = document.createElement('div');
            help.className = 'card mb-4';
            help.id = 'pwaInstallHelp';
            help.innerHTML =
                '<div class="card-header"><i class="bi bi-phone"></i> ' + @TJs("Sådan installerer du appen") + '</div>' +
                '<div class="card-body"><p class="mb-0"></p></div>';
            help.querySelector('p').textContent = steps;

            var content = document.querySelector('.pwa-content');
            content && content.insertBefore(help, content.firstChild);

            var manifestPromise = fetch('/manifest.webmanifest')
                .then(function (r) { return { status: r.status, ok: r.ok }; })
                .catch(function (err) { return { status: null, ok: false, error: (err && err.message) || String(err) }; });

            Promise.allSettled([swPromise, manifestPromise]).then(function (results) {
                // The browser evaluates installability asynchronously - give it a good while before
                // reporting what it decided (it can take several seconds, sometimes longer).
                setTimeout(function () {
                    var manifestResult = results[1].value || {};
                    var check = function (pass) { return pass ? '✅' : '❌'; };

                    var lines = [
                        check(window.isSecureContext) + ' Sikker forbindelse (https eller localhost): ' +
                            (window.isSecureContext ? 'ja' : 'NEJ — installation er kun muligt over https eller localhost'),
                        check(swSupported) + ' Service worker understøttet af browseren: ' + (swSupported ? 'ja' : 'nej'),
                    ];
                    if (swSupported) {
                        lines.push(check(swOk === true) + ' Service worker registreret: ' + (swOk === true ? 'ja' : ('NEJ — ' + swError)));
                    }
                    lines.push(check(manifestResult.ok) + ' Manifest hentet: ' + (manifestResult.ok ? 'ja' : ('NEJ — status ' + (manifestResult.status ?? manifestResult.error))));
                    lines.push(check(promptFired) + ' Browseren tilbød automatisk installation: ' + (promptFired ? 'ja' : 'nej (brug de manuelle trin ovenfor)'));
                    lines.push('URL: ' + location.href);
                    lines.push('User-Agent: ' + navigator.userAgent);

                    var panel = document.createElement('div');
                    panel.className = 'card mb-4';
                    panel.innerHTML =
                        '<div class="card-header"><i class="bi bi-bug"></i> Installations-diagnose</div>' +
                        '<div class="card-body"><pre style="white-space:pre-wrap;word-break:break-word;font-size:.75rem;margin:0;"></pre></div>';
                    panel.querySelector('pre').textContent = lines.join('\n');

                    var help2 = document.getElementById('pwaInstallHelp');
                    if (help2 && help2.parentNode) {
                        help2.parentNode.insertBefore(panel, help2.nextSibling);
                    } else {
                        var content2 = document.querySelector('.pwa-content');
                        content2 && content2.insertBefore(panel, content2.firstChild);
                    }
                }, 6000);
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
