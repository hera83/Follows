@model web.ViewModels.FeedIndexViewModel
@using web.Constants

<div>
    <div class="page-header">
        <h1><i class="bi bi-images me-2"></i>@T("Feeds")</h1>
        <p>@T("Del historier, billeder og videoer fra dit ophold — så kan dine venner og familie følg med hjemmefra.")</p>
    </div>

    <div class="feed-page">
        <div class="card feed-composer">
            <form id="feedComposerForm"
                  action="@Url.Action("Create", "Feed")" method="post" enctype="multipart/form-data"
                  data-max-files="@FeedLimits.MaxFilesPerPost"
                  data-max-image-bytes="@FeedLimits.MaxImageBytes"
                  data-max-video-bytes="@FeedLimits.MaxVideoBytes">
                @Html.AntiForgeryToken()
                <div class="feed-composer-top">
                    <div class="feed-avatar">
                        @if (Model.CurrentUserHasAvatar)
                        {
                            <img src="@Url.Action("Avatar", "Profile")" alt="@Model.CurrentUserDisplayName" />
                        }
                        else
                        {
                            <i class="bi bi-person-circle"></i>
                        }
                    </div>
                    <textarea name="Caption" id="feedComposerCaption" class="feed-composer-textarea" rows="2"
                              maxlength="@FeedLimits.MaxCaptionLength"
                              placeholder="@T("Del en historie fra opholdet...")"></textarea>
                </div>

                <div id="feedComposerPreview" class="feed-composer-preview"></div>

                <input type="file" id="feedComposerFileInput" name="Files" class="d-none" multiple
                       accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,video/quicktime" />

                <div class="feed-composer-toolbar">
                    <button type="button" class="btn btn-secondary" id="feedComposerAttachBtn">
                        <i class="bi bi-images me-1"></i> @T("Billede/video")
                    </button>
                    <button type="submit" class="btn btn-primary ms-auto" id="feedComposerSubmitBtn" disabled>
                        <i class="bi bi-send me-1"></i> @T("Del historie")
                    </button>
                </div>
            </form>
        </div>

        @if (Model.Posts.Count == 0)
        {
            <div class="feed-empty" id="feedEmptyState">
                <i class="bi bi-images"></i>
                <h2>@T("Ingen opslag endnu")</h2>
                <p>@T("Vær den første til at dele et billede, en video eller en historie fra opholdet.")</p>
            </div>
        }

        <div id="feedTranslatingBanner" class="feed-translating-banner" role="status" aria-live="polite"
             data-format="@Model.TranslatingBannerFormat" data-label="@Model.TranslatingLabel">
            <span class="spinner-border spinner-border-sm"></span>
            <span id="feedTranslatingText"></span>
        </div>

        <div id="feedList" class="feed-list">
            @await Html.PartialAsync("_FeedPostList", Model)
        </div>
    </div>
</div>

<!-- Bekræft sletning -->
<div class="modal fade" id="feedConfirmDeleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5"><i class="bi bi-exclamation-triangle text-danger me-2"></i>@T("Bekræft sletning")</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T("Luk")"></button>
            </div>
            <div class="modal-body">
                <p id="feedConfirmDeleteText" class="mb-0">@T("Er du sikker?")</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="bi bi-x-lg me-1"></i>@T("Annuller")</button>
                <button type="button" class="btn btn-danger" id="feedConfirmDeleteBtn"><i class="bi bi-trash me-1"></i>@T("Slet")</button>
            </div>
        </div>
    </div>
</div>

<!-- Rediger opslag -->
<div class="modal fade" id="feedEditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="feedEditForm">
                <div class="modal-header">
                    <h1 class="modal-title fs-5"><i class="bi bi-pencil me-2"></i>@T("Rediger opslag")</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T("Luk")"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="feedEditPostId" />
                    <div class="mb-3">
                        <label for="feedEditCaption" class="form-label">@T("Historie")</label>
                        <textarea id="feedEditCaption" class="form-control" rows="4" maxlength="@FeedLimits.MaxCaptionLength"></textarea>
                    </div>
                    @if (Model.CurrentUserIsModerator)
                    {
                        <div class="mb-3" id="feedEditDateWrap">
                            <label for="feedEditDate" class="form-label">@T("Dato og tidspunkt")</label>
                            <input type="datetime-local" id="feedEditDate" class="form-control" />
                            <div class="form-text">@T("Kun admin/udvikler kan rette datoen — brug det til at lægge gamle begivenheder ind på deres rigtige plads i tidslinjen.")</div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="bi bi-x-lg me-1"></i>@T("Annuller")</button>
                    <button type="submit" class="btn btn-primary" id="feedEditSaveBtn"><i class="bi bi-floppy me-1"></i>@T("Gem")</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Lightbox -->
<div class="feed-lightbox" id="feedLightbox" aria-hidden="true">
    <button type="button" class="feed-lightbox-close" id="feedLightboxClose" aria-label="@T("Luk")"><i class="bi bi-x-lg"></i></button>
    <button type="button" class="feed-lightbox-nav feed-lightbox-prev" id="feedLightboxPrev" aria-label="@T("Forrige")"><i class="bi bi-chevron-left"></i></button>
    <div class="feed-lightbox-content" id="feedLightboxContent"></div>
    <button type="button" class="feed-lightbox-nav feed-lightbox-next" id="feedLightboxNext" aria-label="@T("Næste")"><i class="bi bi-chevron-right"></i></button>
</div>

@section Scripts {
    <script>
        (() => {
            const feedList = document.getElementById('feedList');
            const form = document.getElementById('feedComposerForm');
            if (!feedList || !form) return;

            const csrfToken = form.querySelector('input[name="__RequestVerificationToken"]').value;
            const maxFiles = parseInt(form.dataset.maxFiles, 10) || 10;
            const maxImageBytes = parseInt(form.dataset.maxImageBytes, 10);
            const maxVideoBytes = parseInt(form.dataset.maxVideoBytes, 10);

            // ─── Relative timestamps ────────────────────────────────────────────
            // window.appLocale is emitted by _Layout.cshtml (see AppLanguages.GetLocaleTag) - falls back
            // to Danish if unset (unauthenticated viewer, very old cached page, ...). The phrase pieces
            // below are resolved once, server-side, via @@TJs() - this script block is Razor-rendered, so
            // there's no need for a runtime window.i18n lookup here the way site.js needs one.
            const locale = window.appLocale || 'da-DK';
            const relativeWords = {
                now: @TJs("Lige nu"),
                forWord: @TJs("for"),
                minutesAgo: @TJs("min. siden"),
                hoursAgo: @TJs("t. siden"),
                day: @TJs("dag"),
                days: @TJs("dage"),
                agoSuffix: @TJs("siden"),
                at: @TJs("kl.")
            };
            const formatRelative = (iso) => {
                const date = new Date(iso);
                const diffMin = Math.floor((Date.now() - date.getTime()) / 60000);
                if (diffMin < 1) return relativeWords.now;
                if (diffMin < 60) return `${relativeWords.forWord} ${diffMin} ${relativeWords.minutesAgo}`;
                const diffH = Math.floor(diffMin / 60);
                if (diffH < 24) return `${relativeWords.forWord} ${diffH} ${relativeWords.hoursAgo}`;
                const diffD = Math.floor(diffH / 24);
                if (diffD < 7) return `${relativeWords.forWord} ${diffD} ${diffD > 1 ? relativeWords.days : relativeWords.day} ${relativeWords.agoSuffix}`;
                return date.toLocaleDateString(locale, { day: 'numeric', month: 'short', year: 'numeric' }) +
                    ' ' + relativeWords.at + ' ' + date.toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit' });
            };

            const formatTimes = (scope) => {
                (scope || document).querySelectorAll('.feed-time[data-utc]').forEach((el) => {
                    el.textContent = formatRelative(el.dataset.utc);
                    el.title = new Date(el.dataset.utc).toLocaleString(locale);
                });
            };

            // ─── Small entrance animation for freshly-inserted elements ────────
            const animateIn = (el) => {
                if (!el) return;
                el.classList.add('feed-fade-in');
                el.addEventListener('animationend', () => el.classList.remove('feed-fade-in'), { once: true });
            };

            // ─── Composer: textarea autosize + attachments ──────────────────────
            const captionEl = document.getElementById('feedComposerCaption');
            const submitBtn = document.getElementById('feedComposerSubmitBtn');
            const fileInput = document.getElementById('feedComposerFileInput');
            const previewEl = document.getElementById('feedComposerPreview');
            let selectedFiles = [];

            const autoSize = (el) => {
                el.style.height = 'auto';
                el.style.height = Math.min(el.scrollHeight, 200) + 'px';
            };

            const updateSubmitState = () => {
                submitBtn.disabled = !(captionEl.value.trim().length > 0 || selectedFiles.length > 0);
            };

            const syncFileInput = () => {
                const dt = new DataTransfer();
                selectedFiles.forEach((f) => dt.items.add(f));
                fileInput.files = dt.files;
            };

            const renderPreviews = () => {
                previewEl.innerHTML = '';
                selectedFiles.forEach((file, idx) => {
                    const chip = document.createElement('div');
                    chip.className = 'feed-preview-chip';

                    if (file.type.startsWith('video/')) {
                        chip.innerHTML = '<div class="feed-preview-video"><i class="bi bi-camera-video-fill"></i></div>';
                    } else {
                        const img = document.createElement('img');
                        img.src = URL.createObjectURL(file);
                        chip.appendChild(img);
                    }

                    const removeBtn = document.createElement('button');
                    removeBtn.type = 'button';
                    removeBtn.className = 'feed-preview-remove';
                    removeBtn.setAttribute('aria-label', @TJs("Fjern"));
                    removeBtn.innerHTML = '<i class="bi bi-x"></i>';
                    removeBtn.addEventListener('click', () => {
                        selectedFiles.splice(idx, 1);
                        syncFileInput();
                        renderPreviews();
                        updateSubmitState();
                    });
                    chip.appendChild(removeBtn);
                    previewEl.appendChild(chip);
                });
            };

            document.getElementById('feedComposerAttachBtn').addEventListener('click', () => fileInput.click());

            captionEl.addEventListener('input', () => { autoSize(captionEl); updateSubmitState(); });

            fileInput.addEventListener('change', () => {
                const incoming = Array.from(fileInput.files || []);
                for (const file of incoming) {
                    if (selectedFiles.length >= maxFiles) {
                        window.FvToast.show('warning', `${@TJs("Du kan højst vedhæfte")} ${maxFiles} ${@TJs("filer.")}`);
                        break;
                    }
                    const isVideo = file.type.startsWith('video/');
                    const maxBytes = isVideo ? maxVideoBytes : maxImageBytes;
                    if (file.size > maxBytes) {
                        window.FvToast.show('warning', `'${file.name}' ${@TJs("er for stor.")}`);
                        continue;
                    }
                    selectedFiles.push(file);
                }
                syncFileInput();
                renderPreviews();
                updateSubmitState();
            });

            // ─── Shared, deduped fetch of one post's card HTML ──────────────────
            // Feed/Post/{id} does the slow, live translation for anything not cached yet. Several
            // things can want the same post refreshed close together (the initial background scan,
            // posting a comment on it, another "Indlæs flere" scan) — without dedup, each would fire
            // its own independent live-translate request, and on a modest self-hosted AI backend that
            // serves one request at a time, those pile up behind each other and never seem to finish.
            // Callers for the same postId share one in-flight request instead.
            const inFlightPostFetches = new Map();

            const fetchPostCardHtml = (postId) => {
                if (inFlightPostFetches.has(postId)) return inFlightPostFetches.get(postId);

                const promise = fetch(`/Feed/Post/${postId}`, { headers: { 'X-Requested-With': 'fetch' } })
                    .then((res) => (res.ok ? res.text() : null))
                    .catch(() => null)
                    .finally(() => inFlightPostFetches.delete(postId));

                inFlightPostFetches.set(postId, promise);
                return promise;
            };

            const prependPost = async (postId) => {
                // PostFast: a post you just created is, by definition, already in your own language —
                // no reason to make you wait on a live translate/verify pass just to see it appear.
                const res = await fetch(`/Feed/PostFast/${postId}`, { headers: { 'X-Requested-With': 'fetch' } });
                if (!res.ok) return;
                const html = await res.text();
                document.getElementById('feedEmptyState')?.remove();
                feedList.insertAdjacentHTML('afterbegin', html);
                const el = feedList.firstElementChild;
                formatTimes(el);
                animateIn(el);
            };

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                if (submitBtn.disabled) return;

                submitBtn.disabled = true;
                const originalHtml = submitBtn.innerHTML;
                submitBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> ${@TJs("Deler...")}`;

                const data = await window.FvForm.submit(form);

                submitBtn.innerHTML = originalHtml;

                if (data.success && data.postId) {
                    captionEl.value = '';
                    autoSize(captionEl);
                    selectedFiles = [];
                    syncFileInput();
                    renderPreviews();
                    await prependPost(data.postId);
                    // Catches any other post on the page still waiting on a translation — a new
                    // post/comment is a good moment to nudge those along too, per the same sync
                    // the initial page load already kicks off.
                    scanForPendingTranslations(feedList);
                }
                updateSubmitState();
            });

            // ─── Single-post refresh helper (translation-sync only — see appendComment/deleteComment
            // below for why adding/removing a comment no longer routes through here) ──────────────
            const refreshPost = async (postId) => {
                const html = await fetchPostCardHtml(postId);
                if (!html) return false;
                const old = feedList.querySelector(`.feed-post[data-post-id="${postId}"]`);
                if (old) {
                    old.outerHTML = html;
                    const fresh = feedList.querySelector(`.feed-post[data-post-id="${postId}"]`);
                    formatTimes(fresh);
                    animateIn(fresh);
                }
                return true;
            };

            // ─── Instantly show a just-posted comment ───────────────────────────
            // A comment is always in its own author's language, so it never needs translating for
            // them — no reason to route it through the slow live-translate path (refreshPost/
            // Feed/Post/{id}) just to make it appear. CommentItem renders it as-is, no AI call, so
            // this is effectively instant.
            const appendComment = async (postId, commentId) => {
                try {
                    const res = await fetch(`/Feed/CommentItem/${commentId}`, { headers: { 'X-Requested-With': 'fetch' } });
                    if (!res.ok) return;
                    const html = await res.text();

                    const article = feedList.querySelector(`.feed-post[data-post-id="${postId}"]`);
                    if (!article) return;

                    const list = article.querySelector('.feed-comments');
                    list.insertAdjacentHTML('beforeend', html);
                    const newEl = list.lastElementChild;
                    formatTimes(newEl);
                    animateIn(newEl);

                    const countEl = article.querySelector('.feed-comment-count');
                    if (countEl) {
                        const n = (parseInt(countEl.dataset.count, 10) || 0) + 1;
                        countEl.dataset.count = n;
                        countEl.querySelector('.feed-comment-count-num').textContent = n;
                    }

                    // A brand-new comment hasn't been through language verification yet — flag the
                    // post so the sync we trigger right after this picks it up (for anyone else who
                    // might need it translated; the author who just wrote it never will).
                    article.dataset.needsTranslation = 'true';
                } catch { /* ignorer */ }
            };

            // ─── Background translation pass ────────────────────────────────────
            // The feed always renders instantly with cached translations (or original text) — posts
            // still needing a live translation are flagged data-needs-translation="true" server-side.
            // We pick those up here, translate them one request per post in the background (each
            // request also translates that post's comments), and show a small "Oversætter..." banner
            // while any are in flight so a slow translation never looks like a frozen page.
            const translatingBanner = document.getElementById('feedTranslatingBanner');
            const translatingText = document.getElementById('feedTranslatingText');
            const translatingFormat = translatingBanner.dataset.format || 'Oversætter {0} opslag...';
            const translatingLabel = translatingBanner.dataset.label || 'Oversætter...';
            let pendingTranslations = 0;

            const updateTranslatingBanner = () => {
                if (pendingTranslations > 0) {
                    translatingText.textContent = translatingFormat.replace('{0}', pendingTranslations);
                    translatingBanner.classList.add('is-visible');
                } else {
                    translatingBanner.classList.remove('is-visible');
                }
            };

            // Shows the same "Oversætter..." badge a post gets server-rendered with when it arrives
            // already needing translation. Posts picked up here often don't have it yet — e.g. a
            // comment just appended by appendComment() — since the last HTML the server sent for that
            // post predates the new comment. refreshPost() below replaces the whole article with a
            // fresh server render once the translation lands, which removes this again on its own.
            const showPostTranslatingBadge = (article) => {
                if (article.querySelector('.feed-translating-badge')) return;
                const badge = document.createElement('span');
                badge.className = 'feed-translating-badge';
                badge.innerHTML = `<span class="spinner-border spinner-border-sm"></span> ${translatingLabel}`;
                const header = article.querySelector('.feed-post-header');
                (header || article).insertAdjacentElement('afterend', badge);
            };

            const scanForPendingTranslations = (scope) => {
                const pending = Array.from((scope || feedList).querySelectorAll('.feed-post[data-needs-translation="true"]'));
                if (!pending.length) return;

                // Mark as in-progress immediately so a second scan (e.g. right after Indlæs flere)
                // can't pick the same post up twice while its first request is still in flight.
                pending.forEach((article) => {
                    article.dataset.needsTranslation = 'in-progress';
                    showPostTranslatingBadge(article);
                });

                pendingTranslations += pending.length;
                updateTranslatingBanner();

                pending.forEach(async (article) => {
                    const postId = article.dataset.postId;
                    const ok = await refreshPost(postId);
                    if (!ok) {
                        // Fetch/translate failed (network hiccup, AI Gateway timeout, ...) — put it
                        // back to "true" so the next scan (a reload, or the next comment/post) retries
                        // it instead of it being stuck forever.
                        const stillThere = feedList.querySelector(`.feed-post[data-post-id="${postId}"]`);
                        if (stillThere) stillThere.dataset.needsTranslation = 'true';
                    }
                    pendingTranslations = Math.max(0, pendingTranslations - 1);
                    updateTranslatingBanner();
                });
            };

            // ─── Like toggle ─────────────────────────────────────────────────────
            const toggleLike = async (btn) => {
                if (btn.disabled) return;
                btn.disabled = true;
                try {
                    const fd = new FormData();
                    fd.set('postId', btn.dataset.postId);
                    fd.set('__RequestVerificationToken', csrfToken);
                    const res = await fetch('/Feed/ToggleLike', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'fetch' } });
                    const data = await res.json();
                    if (data.success) {
                        btn.classList.toggle('is-liked', data.liked);
                        btn.setAttribute('aria-pressed', String(data.liked));
                        btn.querySelector('i').className = `bi ${data.liked ? 'bi-heart-fill' : 'bi-heart'}`;
                        btn.querySelector('.feed-like-count').textContent = data.likeCount;
                        // The liker list just changed — drop any cached names for this post so the
                        // hover popup re-fetches instead of showing a stale list next time.
                        likersCache.delete(btn.dataset.postId);
                    }
                } catch {
                    window.FvToast.show('error', @TJs("Netværksfejl. Prøv igen."));
                } finally {
                    btn.disabled = false;
                }
            };

            // ─── Like button hover popup: who liked this post ───────────────────
            // A discreet, title-tooltip-like popup listing likers' names, shown after the mouse has
            // rested on the heart for a beat (not immediately, like a native title tooltip). Names are
            // fetched on demand and cached per post so hovering the same post again is instant; the
            // cache is invalidated above whenever the current user's own like state changes.
            const likersCache = new Map(); // postId -> { names, total }
            const likersTooltip = document.createElement('div');
            likersTooltip.className = 'feed-likers-tooltip';
            likersTooltip.setAttribute('role', 'tooltip');
            document.body.appendChild(likersTooltip);

            let likerHoverTimer = null;
            let likerHoverBtn = null;

            const hideLikersTooltip = () => {
                likersTooltip.classList.remove('is-visible');
                likerHoverBtn = null;
            };

            const positionLikersTooltip = (btn) => {
                const rect = btn.getBoundingClientRect();
                const tipRect = likersTooltip.getBoundingClientRect();
                let left = rect.left + rect.width / 2 - tipRect.width / 2;
                left = Math.max(8, Math.min(left, window.innerWidth - tipRect.width - 8));
                let top = rect.top - tipRect.height - 8;
                let flipped = false;
                if (top < 8) { top = rect.bottom + 8; flipped = true; }
                likersTooltip.style.left = `${left}px`;
                likersTooltip.style.top = `${top}px`;
                likersTooltip.classList.toggle('is-flipped', flipped);
                likersTooltip.style.setProperty('--arrow-left', `${rect.left + rect.width / 2 - left}px`);
            };

            const renderLikersTooltip = (btn, data) => {
                if (likerHoverBtn !== btn) return; // moved on before the fetch finished
                if (!data || !data.names || data.names.length === 0) { hideLikersTooltip(); return; }

                const extra = data.total - data.names.length;
                const lines = extra > 0 ? [...data.names, `${@TJs("og")} ${extra} ${@TJs("andre")}`] : data.names;
                likersTooltip.textContent = lines.join('\n');
                likersTooltip.classList.add('is-visible');
                positionLikersTooltip(btn);
            };

            const showLikersTooltip = async (btn) => {
                const postId = btn.dataset.postId;
                const likeCount = parseInt(btn.querySelector('.feed-like-count')?.textContent, 10) || 0;
                if (likeCount === 0) return;

                const cached = likersCache.get(postId);
                if (cached) { renderLikersTooltip(btn, cached); return; }

                try {
                    const res = await fetch(`/Feed/Likers/${postId}`, { headers: { 'X-Requested-With': 'fetch' } });
                    if (!res.ok) return;
                    const data = await res.json();
                    if (!data.success) return;
                    likersCache.set(postId, data);
                    renderLikersTooltip(btn, data);
                } catch { /* diskret popup — ingen fejlbesked ved netværksfejl */ }
            };

            feedList.addEventListener('mouseover', (e) => {
                const btn = e.target.closest('.feed-like-btn');
                if (!btn || btn.contains(e.relatedTarget)) return;
                likerHoverBtn = btn;
                clearTimeout(likerHoverTimer);
                likerHoverTimer = setTimeout(() => showLikersTooltip(btn), 1000);
            });

            feedList.addEventListener('mouseout', (e) => {
                const btn = e.target.closest('.feed-like-btn');
                if (!btn || btn.contains(e.relatedTarget)) return;
                clearTimeout(likerHoverTimer);
                hideLikersTooltip();
            });

            window.addEventListener('scroll', hideLikersTooltip, true);
            window.addEventListener('resize', hideLikersTooltip);

            // ─── Load more ───────────────────────────────────────────────────────
            const loadMore = async (btn) => {
                const beforeId = btn.dataset.beforeId;
                const wrap = btn.closest('.feed-load-more-wrap');
                btn.disabled = true;
                btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> ${@TJs("Indlæser...")}`;
                try {
                    const res = await fetch(`/Feed/LoadMore?beforeId=${encodeURIComponent(beforeId)}`, { headers: { 'X-Requested-With': 'fetch' } });
                    if (!res.ok) return;
                    const html = await res.text();
                    wrap?.remove();
                    const temp = document.createElement('div');
                    temp.innerHTML = html;
                    Array.from(temp.children).forEach((node) => feedList.appendChild(node));
                    formatTimes(feedList);
                    scanForPendingTranslations(feedList);
                } catch {
                    window.FvToast.show('error', @TJs("Netværksfejl. Prøv igen."));
                }
            };

            // ─── Lightbox ────────────────────────────────────────────────────────
            const lightbox = document.getElementById('feedLightbox');
            const lightboxContent = document.getElementById('feedLightboxContent');
            const lightboxPrev = document.getElementById('feedLightboxPrev');
            const lightboxNext = document.getElementById('feedLightboxNext');
            let lightboxItems = [];
            let lightboxIndex = 0;

            // Explicitly pause + drop the source instead of relying on innerHTML replacement to
            // do it — that stops the in-flight download/buffering right away rather than letting
            // it linger in the background while the next slide's video starts loading. The
            // on-property handlers (rather than addEventListener) are cleared first so this
            // intentional teardown can never be mistaken for a real playback error and clobber
            // whatever slide gets rendered next.
            const stopLightboxVideo = () => {
                const playingVideo = lightboxContent.querySelector('video');
                if (!playingVideo) return;
                playingVideo.onerror = null;
                playingVideo.onwaiting = null;
                playingVideo.onplaying = null;
                playingVideo.oncanplay = null;
                playingVideo.pause();
                playingVideo.removeAttribute('src');
                playingVideo.load();
            };

            const renderLightbox = () => {
                const item = lightboxItems[lightboxIndex];
                if (!item) return;
                stopLightboxVideo();

                if (item.video) {
                    // Fixed frame (see .feed-lightbox-video-frame in site.css) so the box never
                    // resizes once metadata arrives. No autoplay — the viewer presses play
                    // themselves; the spinner just reflects the video's own buffering state
                    // (shown until enough has downloaded to play, and again if it stalls).
                    lightboxContent.innerHTML = `
                        <div class="feed-lightbox-video-frame">
                            <video src="/Feed/Media/${item.id}" controls playsinline preload="auto"></video>
                            <div class="feed-lightbox-video-buffering"><span class="spinner-border" role="status"></span></div>
                        </div>`;
                    const videoEl = lightboxContent.querySelector('video');
                    const bufferingEl = lightboxContent.querySelector('.feed-lightbox-video-buffering');
                    videoEl.loop = false; // play once — never restart on its own when it finishes
                    videoEl.onended = () => { videoEl.pause(); videoEl.currentTime = 0; };
                    videoEl.onwaiting = () => { bufferingEl.style.display = 'flex'; };
                    videoEl.onplaying = () => { bufferingEl.style.display = 'none'; };
                    videoEl.oncanplay = () => { bufferingEl.style.display = 'none'; };
                    videoEl.onerror = () => {
                        lightboxContent.innerHTML = `<div class="feed-lightbox-video-frame">
                            <span class="feed-lightbox-video-error">${@TJs("Videoen kunne ikke indlæses.")}</span>
                        </div>`;
                    };
                } else {
                    lightboxContent.innerHTML = `<img src="/Feed/Media/${item.id}" class="feed-lightbox-image" alt="${@TJs("Billede")}" />`;
                }

                const showNav = lightboxItems.length > 1;
                lightboxPrev.style.visibility = showNav ? 'visible' : 'hidden';
                lightboxNext.style.visibility = showNav ? 'visible' : 'hidden';
            };

            const openLightbox = (tileBtn) => {
                const grid = tileBtn.closest('.feed-media-grid');
                // Slide through every image/video in the post, not just the tiles actually
                // rendered in the compact grid (the "+N" tile hides the rest of them).
                lightboxItems = JSON.parse(grid.dataset.media || '[]');
                lightboxIndex = parseInt(tileBtn.dataset.index, 10) || 0;
                renderLightbox();
                lightbox.classList.add('is-open');
                lightbox.setAttribute('aria-hidden', 'false');
            };

            const closeLightbox = () => {
                stopLightboxVideo();
                lightbox.classList.remove('is-open');
                lightbox.setAttribute('aria-hidden', 'true');
                lightboxContent.innerHTML = '';
            };

            document.getElementById('feedLightboxClose').addEventListener('click', closeLightbox);
            lightboxPrev.addEventListener('click', () => {
                lightboxIndex = (lightboxIndex - 1 + lightboxItems.length) % lightboxItems.length;
                renderLightbox();
            });
            lightboxNext.addEventListener('click', () => {
                lightboxIndex = (lightboxIndex + 1) % lightboxItems.length;
                renderLightbox();
            });
            lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
            document.addEventListener('keydown', (e) => {
                if (!lightbox.classList.contains('is-open')) return;
                if (e.key === 'Escape') closeLightbox();
                if (e.key === 'ArrowLeft') lightboxPrev.click();
                if (e.key === 'ArrowRight') lightboxNext.click();
            });

            // ─── Expand media grid (reveal the photos/videos hidden behind "+N") ──
            const toggleMediaExpand = (btn) => {
                const grid = btn.closest('.feed-post')?.querySelector('.feed-media-grid');
                if (!grid) return;
                const expandText = btn.querySelector('.feed-media-expand-text');
                const icon = btn.querySelector('i');
                const visibleCount = parseInt(grid.dataset.count, 10) || 4;

                if (grid.classList.contains('is-expanded')) {
                    Array.from(grid.querySelectorAll('.feed-media-item')).slice(visibleCount).forEach((el) => el.remove());
                    grid.classList.remove('is-expanded');
                    expandText.textContent = btn.dataset.expandLabel;
                    icon.className = 'bi bi-arrows-angle-expand';
                } else {
                    const items = JSON.parse(grid.dataset.media || '[]');
                    const postId = grid.closest('.feed-post').dataset.postId;
                    for (let i = visibleCount; i < items.length; i++) {
                        const item = items[i];
                        const tile = document.createElement('button');
                        tile.type = 'button';
                        tile.className = 'feed-media-item' + (item.video ? ' feed-media-video' : '');
                        tile.dataset.postId = postId;
                        tile.dataset.mediaId = item.id;
                        tile.dataset.index = i;
                        tile.innerHTML = item.video
                            ? '<span class="feed-media-play"><i class="bi bi-play-circle-fill"></i></span>'
                            : `<img src="/Feed/Media/${item.id}" loading="lazy" alt="${@TJs("Opslagsbillede")}" />`;
                        grid.appendChild(tile);
                    }
                    grid.classList.add('is-expanded');
                    expandText.textContent = btn.dataset.collapseLabel;
                    icon.className = 'bi bi-arrows-angle-contract';
                }
            };

            // ─── Confirm-delete modal (shared for posts & comments) ────────────
            const confirmModalEl = document.getElementById('feedConfirmDeleteModal');
            const bsConfirmModal = new bootstrap.Modal(confirmModalEl);
            const confirmText = document.getElementById('feedConfirmDeleteText');
            const confirmBtn = document.getElementById('feedConfirmDeleteBtn');
            let pendingDelete = null;

            const confirmDelete = (type, id) => {
                pendingDelete = { type, id };
                confirmText.textContent = type === 'post'
                    ? @TJs("Er du sikker på, at du vil slette dette opslag? Billeder, videoer og kommentarer forsvinder også.")
                    : @TJs("Er du sikker på, at du vil slette denne kommentar?");
                bsConfirmModal.show();
            };

            confirmBtn.addEventListener('click', async () => {
                if (!pendingDelete) return;
                confirmBtn.disabled = true;
                try {
                    const fd = new FormData();
                    fd.set('__RequestVerificationToken', csrfToken);

                    if (pendingDelete.type === 'post') {
                        fd.set('postId', pendingDelete.id);
                        const res = await fetch('/Feed/DeletePost', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'fetch' } });
                        const data = await res.json();
                        window.FvToast.show(data.type || (data.success ? 'success' : 'error'), data.message);
                        if (data.success) {
                            feedList.querySelector(`.feed-post[data-post-id="${pendingDelete.id}"]`)?.remove();
                            if (!feedList.querySelector('.feed-post')) location.reload();
                        }
                    } else {
                        fd.set('commentId', pendingDelete.id);
                        const res = await fetch('/Feed/DeleteComment', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'fetch' } });
                        const data = await res.json();
                        window.FvToast.show(data.type || (data.success ? 'success' : 'error'), data.message);
                        if (data.success) {
                            // Removing a comment doesn't need a live-translate round trip either —
                            // just take it out and update the count directly.
                            feedList.querySelector(`.feed-comment[data-comment-id="${pendingDelete.id}"]`)?.remove();
                            if (data.postId) {
                                const article = feedList.querySelector(`.feed-post[data-post-id="${data.postId}"]`);
                                const countEl = article?.querySelector('.feed-comment-count');
                                if (countEl) {
                                    const n = Math.max(0, (parseInt(countEl.dataset.count, 10) || 0) - 1);
                                    countEl.dataset.count = n;
                                    countEl.querySelector('.feed-comment-count-num').textContent = n;
                                }
                            }
                        }
                    }
                } catch {
                    window.FvToast.show('error', @TJs("Netværksfejl. Prøv igen."));
                } finally {
                    confirmBtn.disabled = false;
                    bsConfirmModal.hide();
                    pendingDelete = null;
                }
            });

            // ─── Edit post modal ─────────────────────────────────────────────────
            const editModalEl = document.getElementById('feedEditModal');
            const bsEditModal = new bootstrap.Modal(editModalEl);
            const editForm = document.getElementById('feedEditForm');
            const editPostIdEl = document.getElementById('feedEditPostId');
            const editCaptionEl = document.getElementById('feedEditCaption');
            const editDateEl = document.getElementById('feedEditDate');
            const editSaveBtn = document.getElementById('feedEditSaveBtn');

            // datetime-local wants/gives local time with no timezone info — format an ISO UTC string
            // down to "YYYY-MM-DDTHH:mm" in the browser's local time for the input's initial value.
            const toLocalDatetimeValue = (isoUtc) => {
                const d = new Date(isoUtc);
                const pad = (n) => String(n).padStart(2, '0');
                return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
            };

            const openEditModal = async (postId) => {
                const res = await fetch(`/Feed/EditPostData/${postId}`, { headers: { 'X-Requested-With': 'fetch' } });
                const data = await res.json();
                if (!data.success) {
                    window.FvToast.show(data.type || 'error', data.message || @TJs("Opslaget kunne ikke hentes."));
                    return;
                }

                editPostIdEl.value = data.postId;
                editCaptionEl.value = data.caption || '';
                if (editDateEl) {
                    if (data.canEditDate) {
                        editDateEl.disabled = false;
                        editDateEl.value = toLocalDatetimeValue(data.createdAtUtc);
                    } else {
                        editDateEl.disabled = true;
                    }
                }
                bsEditModal.show();
            };

            editForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                editSaveBtn.disabled = true;
                try {
                    const fd = new FormData();
                    fd.set('__RequestVerificationToken', csrfToken);
                    fd.set('PostId', editPostIdEl.value);
                    fd.set('Caption', editCaptionEl.value);
                    if (editDateEl && !editDateEl.disabled && editDateEl.value) {
                        // The input holds local time with no offset — reinterpret it as local via
                        // `new Date(...)`, then send it as a proper UTC ISO string.
                        fd.set('CreatedAtUtc', new Date(editDateEl.value).toISOString());
                    }

                    const res = await fetch('/Feed/EditPost', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'fetch' } });
                    const data = await res.json();
                    window.FvToast.show(data.type || (data.success ? 'success' : 'error'), data.message);
                    if (data.success) {
                        bsEditModal.hide();
                        if (data.dateChanged) {
                            // The feed sorts by date — a changed date can move this post anywhere in
                            // the (cursor-paginated) timeline, which a single in-place card swap can't
                            // express. Reloading is the simple, correct way to show it in its new spot.
                            location.reload();
                        } else {
                            await refreshPost(data.postId);
                        }
                    }
                } catch {
                    window.FvToast.show('error', @TJs("Netværksfejl. Prøv igen."));
                } finally {
                    editSaveBtn.disabled = false;
                }
            });

            // ─── Delegated events on the feed list (survives dynamic updates) ──
            feedList.addEventListener('click', (e) => {
                const mediaBtn = e.target.closest('.feed-media-item');
                if (mediaBtn) { openLightbox(mediaBtn); return; }

                const expandBtn = e.target.closest('.feed-media-expand-btn');
                if (expandBtn) { toggleMediaExpand(expandBtn); return; }

                const likeBtn = e.target.closest('.feed-like-btn');
                if (likeBtn) { toggleLike(likeBtn); return; }

                const editPostBtn = e.target.closest('.feed-edit-post');
                if (editPostBtn) { openEditModal(editPostBtn.dataset.postId); return; }

                const deletePostBtn = e.target.closest('.feed-delete-post');
                if (deletePostBtn) { confirmDelete('post', deletePostBtn.dataset.postId); return; }

                const deleteCommentBtn = e.target.closest('.feed-delete-comment');
                if (deleteCommentBtn) { confirmDelete('comment', deleteCommentBtn.dataset.commentId); return; }

                const loadMoreBtn = e.target.closest('.feed-load-more');
                if (loadMoreBtn) { loadMore(loadMoreBtn); }
            });

            feedList.addEventListener('submit', async (e) => {
                const commentForm = e.target.closest('.feed-comment-form');
                if (!commentForm) return;
                e.preventDefault();

                const input = commentForm.querySelector('.feed-comment-input');
                if (!input.value.trim()) return;

                const sendBtn = commentForm.querySelector('.feed-comment-send');
                const originalSendHtml = sendBtn.innerHTML;
                sendBtn.disabled = true;
                sendBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

                try {
                    const data = await window.FvForm.submit(commentForm);

                    if (data.success && data.postId && data.commentId) {
                        input.value = '';
                        await appendComment(data.postId, data.commentId);
                        // Same reasoning as after posting a story: use the moment to nudge along any
                        // other post on the page still waiting on its translation.
                        scanForPendingTranslations(feedList);
                    }
                } finally {
                    sendBtn.disabled = false;
                    sendBtn.innerHTML = originalSendHtml;
                }
            });

            formatTimes(feedList);
            scanForPendingTranslations(feedList);
        })();
    </script>
}
