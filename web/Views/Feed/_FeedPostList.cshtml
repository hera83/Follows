@model web.ViewModels.FeedIndexViewModel

@foreach (var post in Model.Posts)
{
    @await Html.PartialAsync("_FeedPostCard", post)
}

@if (Model.HasMore)
{
    <div class="feed-load-more-wrap">
        <button type="button" class="btn btn-secondary feed-load-more" data-before-id="@Model.NextBeforeId">
            <i class="bi bi-arrow-clockwise me-1"></i> Indlæs flere
        </button>
    </div>
}
