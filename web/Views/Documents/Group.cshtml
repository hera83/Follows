@model web.ViewModels.DocumentGroupDetailViewModel
@using web.Constants

<div>
    <a asp-action="Index" class="doc-back-link"><i class="bi bi-arrow-left me-1"></i>Documents</a>

    <div class="page-header">
        <h1><i class="bi bi-folder2-open me-2"></i><span id="documentGroupName">@Model.Name</span></h1>
        <p id="documentGroupDescription" class="@(string.IsNullOrWhiteSpace(Model.Description) ? "d-none" : "")">@Model.Description</p>
    </div>

    <div class="table-toolbar mb-3">
        <div class="table-toolbar-end">
            @if (Model.CanManage)
            {
                <button class="btn btn-secondary btn-icon" type="button" data-bs-toggle="modal" data-bs-target="#editDocumentGroupModal" title="Rediger gruppe" aria-label="Rediger gruppe">
                    <i class="bi bi-pencil"></i>
                </button>
                <button class="btn btn-outline-danger btn-icon" type="button" data-bs-toggle="modal" data-bs-target="#deleteDocumentGroupModal" title="Slet gruppe" aria-label="Slet gruppe">
                    <i class="bi bi-trash"></i>
                </button>
            }
            <button class="btn btn-primary btn-icon" type="button" data-bs-toggle="modal" data-bs-target="#uploadDocumentModal" title="Upload dokumenter" aria-label="Upload dokumenter">
                <i class="bi bi-cloud-upload"></i>
            </button>
        </div>
    </div>

    <div id="documentsList" data-group-id="@Model.Id">
        @await Html.PartialAsync("_DocumentsList", Model)
    </div>
</div>

@if (Model.CanManage)
{
    <!-- Rediger gruppe -->
    <div class="modal fade" id="editDocumentGroupModal" tabindex="-1" aria-labelledby="editDocumentGroupModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="EditGroup" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="GroupId" value="@Model.Id" />
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="editDocumentGroupModalLabel"><i class="bi bi-pencil me-2"></i>Rediger gruppe</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Luk"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Navn</label>
                            <input name="Name" class="form-control" value="@Model.Name" required maxlength="@DocumentLimits.MaxGroupNameLength" />
                        </div>
                        <div class="mb-0">
                            <label class="form-label">Beskrivelse (valgfri)</label>
                            <textarea name="Description" class="form-control" rows="2" maxlength="@DocumentLimits.MaxGroupDescriptionLength">@Model.Description</textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="bi bi-x-lg me-1"></i>Annuller</button>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-floppy me-1"></i>Gem</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Slet gruppe -->
    <div class="modal fade" id="deleteDocumentGroupModal" tabindex="-1" aria-labelledby="deleteDocumentGroupModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="deleteDocumentGroupModalLabel"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Slet gruppe</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Luk"></button>
                </div>
                <div class="modal-body">
                    Er du sikker på, at du vil slette gruppen <strong>@Model.Name</strong>? Alle dokumenter i gruppen slettes også. Denne handling kan ikke fortrydes.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="bi bi-x-lg me-1"></i>Annuller</button>
                    <form asp-action="DeleteGroup" method="post" id="deleteDocumentGroupForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="groupId" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Slet</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- Upload dokumenter -->
<div class="modal fade" id="uploadDocumentModal" tabindex="-1" aria-labelledby="uploadDocumentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Upload" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="groupId" value="@Model.Id" />
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="uploadDocumentModalLabel"><i class="bi bi-cloud-upload me-2"></i>Upload dokumenter</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Luk"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Filer</label>
                    <input type="file" name="files" class="form-control" multiple required
                           accept=".pdf,.txt,.jpg,.jpeg,.png,.webp,.gif,.doc,.docx,.xls,.xlsx,.ppt,.pptx" />
                    <div class="form-text">Højst @DocumentLimits.MaxFilesPerUpload filer, max @(DocumentLimits.MaxFileBytes / 1024 / 1024) MB pr. fil. PDF, tekst, billeder, Word, Excel og PowerPoint understøttes.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="bi bi-x-lg me-1"></i>Annuller</button>
                    <button type="submit" class="btn btn-primary">
                        <span class="spinner-border spinner-border-sm me-1 d-none" data-upload-spinner></span>
                        <i class="bi bi-cloud-upload me-1" data-upload-icon></i> Upload
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Slet dokument -->
<div class="modal fade" id="deleteDocumentModal" tabindex="-1" aria-labelledby="deleteDocumentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="deleteDocumentModalLabel"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Slet dokument</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Luk"></button>
            </div>
            <div class="modal-body">
                Er du sikker på, at du vil slette dokumentet <strong id="deleteDocumentName"></strong>? Denne handling kan ikke fortrydes.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="bi bi-x-lg me-1"></i>Annuller</button>
                <form asp-action="DeleteDocument" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="documentId" id="deleteDocumentInput" />
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Slet</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Forhåndsvisning -->
<div class="modal fade" id="documentPreviewModal" tabindex="-1" aria-labelledby="documentPreviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="documentPreviewModalLabel">
                    <i class="bi bi-file-earmark me-2" id="documentPreviewIcon"></i><span id="documentPreviewTitle"></span>
                </h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Luk"></button>
            </div>
            <div class="modal-body doc-preview-body" id="documentPreviewBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary d-none" id="documentTranslateBackBtn" title="Tilbage til den oprindelige fil">
                    <i class="bi bi-arrow-left me-1"></i>Tilbage
                </button>
                <button type="button" class="btn btn-secondary" id="documentTranslateBtn" title="Oversæt til dit foretrukne sprog">
                    <span class="spinner-border spinner-border-sm me-1 d-none" data-translate-spinner></span>
                    <i class="bi bi-translate me-1" data-translate-icon></i><span data-translate-label>Oversæt</span>
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="bi bi-x-lg me-1"></i>Luk</button>
                <a class="btn btn-primary" id="documentPreviewDownload" download><i class="bi bi-download me-1"></i>Download</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const groupId = document.getElementById('documentsList').dataset.groupId;
            const listEl = document.getElementById('documentsList');

            const refreshDocuments = async () => {
                try {
                    const res = await fetch(`@Url.Action("DocumentsList")?groupId=${encodeURIComponent(groupId)}`, { headers: { 'X-Requested-With': 'fetch' } });
                    if (!res.ok) return;
                    listEl.innerHTML = await res.text();
                } catch { /* liste forbliver som den var */ }
            };

            const handleAjaxSubmit = (form, modalEl, options = {}) => {
                if (!form) return;
                form.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const submitBtn = form.querySelector('button[type="submit"]');
                    const spinner = form.querySelector('[data-upload-spinner]');
                    const icon = form.querySelector('[data-upload-icon]');
                    if (submitBtn) submitBtn.disabled = true;
                    spinner?.classList.remove('d-none');
                    icon?.classList.add('d-none');
                    const data = await window.FvForm.submit(form);
                    if (submitBtn) submitBtn.disabled = false;
                    spinner?.classList.add('d-none');
                    icon?.classList.remove('d-none');
                    if (data.success) {
                        if (modalEl) bootstrap.Modal.getInstance(modalEl)?.hide();
                        if (options.resetOnSuccess !== false) form.reset();
                        if (options.onSuccess) options.onSuccess(data);
                        else await refreshDocuments();
                    }
                });
            };

            const uploadModal = document.getElementById('uploadDocumentModal');
            handleAjaxSubmit(uploadModal?.querySelector('form'), uploadModal);

            const deleteModal = document.getElementById('deleteDocumentModal');
            handleAjaxSubmit(deleteModal?.querySelector('form'), deleteModal);
            deleteModal?.addEventListener('show.bs.modal', (event) => {
                const btn = event.relatedTarget;
                if (!btn) return;
                document.getElementById('deleteDocumentInput').value = btn.dataset.id;
                document.getElementById('deleteDocumentName').textContent = btn.dataset.title;
            });

            // ─── Rediger/slet gruppe ─────────────────────────────────────────
            const groupNameEl = document.getElementById('documentGroupName');
            const groupDescEl = document.getElementById('documentGroupDescription');

            const editGroupModal = document.getElementById('editDocumentGroupModal');
            handleAjaxSubmit(editGroupModal?.querySelector('form'), editGroupModal, {
                resetOnSuccess: false,
                onSuccess: (data) => {
                    groupNameEl.textContent = data.name;
                    groupDescEl.textContent = data.description || '';
                    groupDescEl.classList.toggle('d-none', !data.description);
                }
            });

            const deleteGroupModal = document.getElementById('deleteDocumentGroupModal');
            handleAjaxSubmit(deleteGroupModal?.querySelector('form'), deleteGroupModal, {
                onSuccess: () => { window.location.href = '@Url.Action("Index")'; }
            });

            // ─── Forhåndsvisning ─────────────────────────────────────────────
            const previewModal = document.getElementById('documentPreviewModal');
            const previewBody = document.getElementById('documentPreviewBody');
            const previewTitle = document.getElementById('documentPreviewTitle');
            const previewIcon = document.getElementById('documentPreviewIcon');
            const previewDownload = document.getElementById('documentPreviewDownload');
            const translateBtn = document.getElementById('documentTranslateBtn');
            const translateSpinner = translateBtn?.querySelector('[data-translate-spinner]');
            const translateIcon = translateBtn?.querySelector('[data-translate-icon]');
            const translateLabel = translateBtn?.querySelector('[data-translate-label]');
            const translateBackBtn = document.getElementById('documentTranslateBackBtn');
            let currentPreviewDocId = null;
            let currentPreviewTitle = '';
            let currentPreviewContentType = '';
            let currentPreviewCanPreview = false;
            let hasTranslatedResult = false; // true once a real translation is showing — next click re-translates (force) instead of using the cache

            // Efter et vellykket oversæt-kald bliver knappen til "Genoversæt", så man kan tvinge en frisk
            // oversættelse igennem (springer serverens cache over) i stedet for altid at få den samme
            // cachede tekst igen — nyttigt hvis første forsøg kom ud tomt/ufuldstændigt. "Tilbage"-knappen
            // følger samme tilstand, da den kun giver mening mens en oversættelse vises.
            const setTranslateButtonMode = (isRetry) => {
                hasTranslatedResult = isRetry;
                if (translateLabel) translateLabel.textContent = isRetry ? 'Genoversæt' : 'Oversæt';
                if (translateIcon) translateIcon.className = `bi ${isRetry ? 'bi-arrow-repeat' : 'bi-translate'} me-1`;
                if (translateBtn) translateBtn.title = isRetry ? 'Oversæt dokumentet igen (ignorerer den gemte oversættelse)' : 'Oversæt til dit foretrukne sprog';
                translateBackBtn?.classList.toggle('d-none', !isRetry);
            };

            // Gengiver den oprindelige forhåndsvisning (PDF/billede/tekst) — brugt både når popup'en
            // åbnes første gang, og når man trykker "Tilbage" fra den oversatte Markdown-visning.
            const renderOriginalPreview = async (id, title, contentType, canPreview) => {
                const viewUrl = `@Url.Action("View")/${id}`;
                previewBody.innerHTML = '<div class="doc-preview-loading"><span class="spinner-border spinner-border-sm me-2"></span>Indlæser...</div>';

                if (!canPreview) {
                    previewBody.innerHTML = `
                        <div class="doc-preview-fallback">
                            <i class="bi bi-file-earmark-x"></i>
                            <p>Forhåndsvisning er ikke tilgængelig for denne filtype.<br>Brug download-knappen for at åbne filen.</p>
                        </div>`;
                    return;
                }

                if (contentType === 'application/pdf') {
                    previewBody.innerHTML = `<iframe src="${viewUrl}" class="doc-preview-iframe" title="${title}"></iframe>`;
                } else if (contentType.startsWith('image/')) {
                    previewBody.innerHTML = `<img src="${viewUrl}" class="doc-preview-image" alt="${title}" />`;
                } else if (contentType === 'text/plain') {
                    try {
                        const res = await fetch(viewUrl, { headers: { 'X-Requested-With': 'fetch' } });
                        const text = await res.text();
                        const pre = document.createElement('pre');
                        pre.className = 'doc-preview-text';
                        pre.textContent = text; // aldrig innerHTML — undgår XSS fra filens indhold
                        previewBody.innerHTML = '';
                        previewBody.appendChild(pre);
                    } catch {
                        previewBody.innerHTML = '<div class="doc-preview-fallback"><p>Kunne ikke indlæse filen.</p></div>';
                    }
                }
            };

            previewModal?.addEventListener('show.bs.modal', async (event) => {
                const btn = event.relatedTarget;
                if (!btn) return;

                const id = btn.dataset.id;
                const title = btn.dataset.title;
                const contentType = btn.dataset.contentType;
                const canPreview = btn.dataset.canPreview === 'true';

                currentPreviewDocId = id;
                currentPreviewTitle = title;
                currentPreviewContentType = contentType;
                currentPreviewCanPreview = canPreview;
                setTranslateButtonMode(false);
                translateBtn?.classList.toggle('d-none', btn.dataset.canTranslate !== 'true');

                previewTitle.textContent = title;
                previewIcon.className = `bi ${btn.dataset.icon || 'bi-file-earmark'} me-2`;
                previewDownload.href = `@Url.Action("Download")/${id}`;

                await renderOriginalPreview(id, title, contentType, canPreview);
            });

            translateBackBtn?.addEventListener('click', async () => {
                setTranslateButtonMode(false);
                await renderOriginalPreview(currentPreviewDocId, currentPreviewTitle, currentPreviewContentType, currentPreviewCanPreview);
            });

            previewModal?.addEventListener('hidden.bs.modal', () => {
                previewBody.innerHTML = ''; // stopper evt. iframe-indlæsning
                translateBtn?.classList.remove('d-none');
            });

            translateBtn?.addEventListener('click', async () => {
                if (!currentPreviewDocId) return;

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                translateBtn.disabled = true;
                translateSpinner?.classList.remove('d-none');
                translateIcon?.classList.add('d-none');
                translateBtn.title = 'Oversætter... kan tage et par minutter for store dokumenter';

                // Uden denne timeout hænger knappen for evigt med en spinner og ingen forklaring, hvis
                // AiGatewayen er langsom, utilgængelig eller fejlkonfigureret — der er intet at fange og
                // vise, fetch() venter bare i det uendelige. Store dokumenter oversættes chunk for chunk
                // server-side (se DocumentsService.TranslateDocumentAsync), i én sammenhængende request,
                // så loftet her skal række til flere chunks i træk på en langsom model - 20 minutter er
                // rigeligt i normale tilfælde, men stadig et loft, så en reelt hængende request en dag
                // bliver synlig i stedet for evigt tavs.
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 20 * 60 * 1000);

                const wasRetry = hasTranslatedResult;

                try {
                    const formData = new FormData();
                    if (token) formData.append('__RequestVerificationToken', token);
                    if (wasRetry) formData.append('force', 'true'); // spring den gemte oversættelse over, oversæt igen fra bunden

                    const res = await fetch(`@Url.Action("Translate")/${currentPreviewDocId}`, {
                        method: 'POST',
                        body: formData,
                        headers: { 'X-Requested-With': 'fetch' },
                        signal: controller.signal
                    });
                    const data = await res.json();

                    if (!data.success) {
                        FvToast.show(data.type || 'error', data.message || 'Oversættelsen mislykkedes.');
                        return;
                    }

                    if (data.alreadyInTargetLanguage) {
                        FvToast.show('info', `Dokumentet er allerede på ${data.targetLanguageName}.`);
                        return;
                    }

                    // Fjern den oprindelige forhåndsvisning (PDF-reader/billede/tekst) og vis den oversatte Markdown i stedet.
                    previewBody.innerHTML = `<div class="doc-preview-markdown">${data.html}</div>`;
                    setTranslateButtonMode(true); // knappen bliver til "Genoversæt" — næste klik tvinger en frisk oversættelse igennem

                    if (data.truncated) {
                        FvToast.show('warning', 'Dokumentet var langt og blev afkortet før oversættelse — enkelte afsnit mangler muligvis.');
                    }
                } catch (err) {
                    FvToast.show('error', err?.name === 'AbortError'
                        ? 'Oversættelsen tog for lang tid og blev afbrudt. Tjek at AI Gateway er tilgængelig under Indstillinger.'
                        : 'Netværksfejl. Prøv igen.');
                } finally {
                    clearTimeout(timeoutId);
                    translateBtn.disabled = false;
                    translateSpinner?.classList.add('d-none');
                    translateIcon?.classList.remove('d-none');
                    setTranslateButtonMode(hasTranslatedResult); // gendan korrekt label/ikon/title (Oversæt eller Genoversæt)
                }
            });
        })();
    </script>
}
