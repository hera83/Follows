@model web.ViewModels.DocumentsIndexViewModel

<div>
    <div class="page-header">
        <h1><i class="bi bi-folder2-open me-2"></i>Documents</h1>
        <p>Gem skoleskemaer, rejseplaner, aktivitetsplaner og andre dokumenter i grupper, så I nemt kan finde dem igen.</p>
    </div>

    <div class="table-toolbar mb-3">
        <div class="table-toolbar-end">
            <button class="btn btn-primary btn-icon" type="button" data-bs-toggle="modal" data-bs-target="#createDocumentGroupModal" title="Ny gruppe" aria-label="Ny gruppe">
                <i class="bi bi-folder-plus"></i>
            </button>
        </div>
    </div>

    <div id="documentGroupsList">
        @await Html.PartialAsync("_DocumentGroupsList", Model)
    </div>
</div>

<!-- Ny gruppe -->
<div class="modal fade" id="createDocumentGroupModal" tabindex="-1" aria-labelledby="createDocumentGroupModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="CreateGroup" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="createDocumentGroupModalLabel"><i class="bi bi-folder-plus me-2"></i>Ny gruppe</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Luk"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Navn</label>
                        <input name="Name" class="form-control" placeholder="f.eks. Skoleskemaer" required maxlength="@DocumentLimits.MaxGroupNameLength" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label">Beskrivelse (valgfri)</label>
                        <textarea name="Description" class="form-control" rows="2" maxlength="@DocumentLimits.MaxGroupDescriptionLength"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><i class="bi bi-x-lg me-1"></i>Annuller</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-floppy me-1"></i>Opret</button>
                </div>
            </form>
        </div>
    </div>
</div>

@using web.Constants

@section Scripts {
    <script>
        (() => {
            const listEl = document.getElementById('documentGroupsList');

            const refreshGroups = async () => {
                try {
                    const res = await fetch('@Url.Action("GroupsList")', { headers: { 'X-Requested-With': 'fetch' } });
                    if (!res.ok) return;
                    listEl.innerHTML = await res.text();
                } catch { /* liste forbliver som den var */ }
            };

            const handleAjaxSubmit = (form, modalEl) => {
                if (!form) return;
                form.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const submitBtn = form.querySelector('button[type="submit"]');
                    if (submitBtn) submitBtn.disabled = true;
                    const data = await window.FvForm.submit(form);
                    if (submitBtn) submitBtn.disabled = false;
                    if (data.success) {
                        if (modalEl) bootstrap.Modal.getInstance(modalEl)?.hide();
                        form.reset();
                        await refreshGroups();
                    }
                });
            };

            const createModal = document.getElementById('createDocumentGroupModal');
            handleAjaxSubmit(createModal?.querySelector('form'), createModal);
        })();
    </script>
}
