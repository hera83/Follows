# Build outputs
**/bin/
**/obj/

# App-specific data (must never end up baked into the image)
web/App_dbs/
web/App_files/
web/appsettings.Development.json

# SQLite files anywhere in the context
**/*.db
**/*.db-shm
**/*.db-wal

# VCS / editors
.git/
.github/
.vs/
.vscode/
.idea/
.claude/
*.user

# Docker files themselves (no need to send to the build context)
Dockerfile
docker-compose*.yml
.dockerignore

# Env files (never bake secrets into the image; loaded by compose instead)
.env
.env.*
!.env.example

# Misc
*.log
Thumbs.db
.DS_Store
